{
  "name": "rollipop-sentry-test",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "rollipop start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bundle:android": "rollipop bundle --platform android --dev false --minify true --bundle-output build/android/index.android.bundle --sourcemap-output build/android/index.android.bundle.map",
    "bundle:ios": "rollipop bundle --platform ios --dev false --minify true --bundle-output build/ios/main.jsbundle --sourcemap-output build/ios/main.jsbundle.map"
  },
  "dependencies": {
    "@sentry/react-native": "8.27.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@sentry/rollup-plugin": "5.4.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "rollipop": "1.0.0-alpha.29",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
